<Project Sdk="Microsoft.NET.Sdk">

  <!-- Step 1 prototype: a cross-platform window (Photino) that hosts the unchanged EqualTune HTML interface. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EqualTune.Shell</AssemblyName>
    <RootNamespace>EqualTune.Shell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="3.*" />
    <ProjectReference Include="..\core\EqualTune.Core.csproj" />
    <!-- The same interface file the Windows app uses. -->
    <Content Include="..\Assets\EqualizerPrototype.html" Link="Assets\EqualizerPrototype.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
